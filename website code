if(e.target.name==="type"){document.getElementById("st").style.display=e.target.value==="found"?"block":"none"}
if(e.target.id==="ft"||e.target.id==="fc")fillList()});
document.addEventListener("input",function(e){if(e.target.id==="q")fillList();if(e.target.id==="u")e.target.value=e.target.value.replace(/\D/g,"").slice(0,6)});
function pad(){var k="";["1","2","3","4","5","6","7","8","9","c","0","b"].forEach(function(x){k+='<button type="button" class="key" data-key="'+x+'" aria-label="'+(x==="c"?"Clear":x==="b"?"Backspace":x)+'">'+(x==="c"?"C":x==="b"?"\u232B":x)+"</button>"});return'<div class="keys">'+k+"</div>"}

document.addEventListener("click",function(e){
var kb=e.target.closest("[data-key]");
if(kb){var inp=document.getElementById("u"),k=kb.getAttribute("data-key");if(k==="c")inp.value="";else if(k==="b")inp.value=inp.value.slice(0,-1);else if(inp.value.length<6)inp.value+=k;inp.focus();return}
var b=e.target.closest("[data-act]");if(!b)return;var a=b.getAttribute("data-act"),it=find(b.getAttribute("data-id"));
if(a==="ret"&&it){release(it)}
else if(a==="del"&&it){if(it.locker)S.lockers[it.locker-1]=null;if(it.matchId){var p=find(it.matchId);if(p){p.matchId=null;if(p.status==="matched")p.status="reported"}}S.items=S.items.filter(function(x){return x!==it})}
else if(a==="reset"){if(!confirm("Delete all data in this browser?"))return;S={items:[],lockers:Array(10).fill(null)}}
else if(a==="seed"){seed()}
else if(a==="out"){adminOK=false}
save();route()});

